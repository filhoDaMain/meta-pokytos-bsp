From b2c2568ddee1a21836a914eeb338cb723f6692f5 Mon Sep 17 00:00:00 2001
From: filhoDaMain <temprilho93@gmail.com>
Date: Thu, 4 Dec 2025 22:36:55 +0000
Subject: [PATCH] drivers: uwe5622: Makefile compatible with out of tree

---
 drivers/net/wireless/uwe5622/Makefile | 41 +++++++++++++++++++++++----
 1 file changed, 36 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/uwe5622/Makefile b/drivers/net/wireless/uwe5622/Makefile
index 313ea512340c..d89b27aacb27 100644
--- a/drivers/net/wireless/uwe5622/Makefile
+++ b/drivers/net/wireless/uwe5622/Makefile
@@ -1,10 +1,41 @@
+export CONFIG_SPARD_WLAN_SUPPORT=y
+export CONFIG_SC23XX=y
+export CONFIG_AW_WIFI_DEVICE_UWE5622=y
+export CONFIG_AW_BIND_VERIFY=y
+export CONFIG_WLAN_UWE5622=m
+export CONFIG_TTY_OVERY_SDIO=m
+export UNISOCWCN_DIR=$(src)/unisocwcn/
+export UNISOC_BSP_INCLUDE=$(UNISOCWCN_DIR)/include
+
+ccflags-y += -I$(UNISOCWCN_DIR)/../tty-sdio -I$(UNISOCWCN_DIR)/../tty-sdio/alicgnment
+ccflags-y += -I$(UNISOCWCN_DIR)/boot -I$(UNISOCWCN_DIR)/include -I$(UNISOCWCN_DIR)/pcie -I$(UNISOCWCN_DIR)/boot  
+ccflags-y += -I$(UNISOCWCN_DIR)/platform -I$(UNISOCWCN_DIR)/platform/rf -I$(UNISOCWCN_DIR)/platform/gnss
+ccflags-y += -I$(UNISOCWCN_DIR)/usb -I$(UNISOCWCN_DIR)/pcie -I$(UNISOCWCN_DIR)/sdio
+ccflags-y += -I$(UNISOCWCN_DIR)/sipc -I$(UNISOCWCN_DIR)/sleep
+ccflags-y += -I$(UNISOCWCN_DIR)/../unisocwifi
+
+
+export UNISOC_FW_PATH_CONFIG="/lib/firmware/"
+
+ifneq ($(KERNELRELEASE),)
+
 obj-$(CONFIG_AW_WIFI_DEVICE_UWE5622) += unisocwcn/
 obj-$(CONFIG_WLAN_UWE5622)    += unisocwifi/
 obj-$(CONFIG_TTY_OVERY_SDIO)  += tty-sdio/
 
-UNISOCWCN_DIR := $(shell cd $(src)/unisocwcn/ && /bin/pwd)
-UNISOC_BSP_INCLUDE := $(UNISOCWCN_DIR)/include
-export UNISOC_BSP_INCLUDE
+else
+    KSRC ?= $(KERNEL_SRC)
+    KERNELDIR := $(KSRC)
+    PWD  := $(shell pwd)
+all:
+	$(info UNISOC_BSP_INCLUDE = $(UNISOC_BSP_INCLUDE))
+	$(info KERNELDIR = $(KERNELDIR))
+	$(MAKE) -C $(KERNELDIR) M=$(PWD)
+
+modules_install:
+	$(MAKE) -C $(KERNELDIR) M=$(PWD) modules_install
+
+clean:
+	$(MAKE) -C $(KERNELDIR) M=$(PWD) clean
 
-UNISOC_FW_PATH_CONFIG := "/lib/firmware/"
-export UNISOC_FW_PATH_CONFIG
+endif

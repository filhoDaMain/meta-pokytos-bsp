FILESEXTRAPATHS:append := "${THISDIR}/files/${MACHINE}/:"

python __anonymous() {
    if 'developer' not in d.getVar('MACHINEOVERRIDES').split(':'):
        d.appendVar('SRC_URI', ' file://0001-rel-orangepi_zero3_defconfig-disable-boot-delay.patch')
    else:
        d.appendVar('SRC_URI', ' file://0001-dev-orangepi_zero3_defconfig-enable-boot-delay.patch')
}

SRC_URI:append = "file://custom.boot.cmd"

do_compile:append() {
    sed -i 's/dtb_marker/${KERNEL_DTB_FILE}/g' "${WORKDIR}/custom.boot.cmd"
    ${B}/tools/mkimage -C none -A arm -T script -d ${WORKDIR}/custom.boot.cmd ${WORKDIR}/custom.boot.scr
}

do_deploy:append() {
    # Replace boot.scr generated by meta-sunxi layer
    rm -f ${DEPLOYDIR}/boot.scr
    install -m 0644 ${WORKDIR}/custom.boot.scr ${DEPLOYDIR}/boot.scr
}
